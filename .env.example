# このファイルを ".env" という名前でコピーし、値を自分のものに書き換えてください。
# .env は .gitignore で除外されるため、GitHub には公開されません。

# Discord Developer Portal で取得した bot トークン
DISCORD_TOKEN=ここにDiscordのbotトークンを貼り付け

# Google AI Studio で取得した Gemini API キー（要約に使用）
GEMINI_API_KEY=ここにGeminiのAPIキーを貼り付け

# （任意）テストするサーバーのID。設定するとスラッシュコマンドが即座に使えるようになる。
# 未設定でも動くが、コマンド反映に時間がかかることがある。
# サーバーIDの調べ方: Discordの設定→詳細設定→開発者モードON → サーバー名を右クリック→「サーバーIDをコピー」
DISCORD_GUILD_ID=

# （任意）議事録作成に成功した後、容量削減のため生の音声ファイル(wav等)を自動削除するか。
# true/false。未設定は true（削除する）。
DELETE_AUDIO_AFTER_PROCESSING=true

# （任意）録音フォルダを保持する日数。この日数を過ぎたフォルダは bot 起動時に自動削除される。
# 0以下で無効化。未設定は 30。
RECORDINGS_RETENTION_DAYS=30

# （任意）手動モード（run_whisper.py / run_pipeline.bat）で話者分離(speaker diarization)を使う場合に設定。
# Google Meet等、1本の音声に全員の声が混ざっている録音から「誰がいつ話したか」を推定できるようになる。
# 1) https://huggingface.co/pyannote/speaker-diarization-3.1 で利用規約に同意
# 2) https://huggingface.co/settings/tokens でアクセストークンを発行し、ここに貼り付け
# 未設定の場合は話者分離をスキップし、従来通りの書き起こしのみ行う。
HF_TOKEN=
