@echo off
:: コマンドプロンプトの文字コードをUTF-8に変更（日本語の文字化け防止）
chcp 65001 > nul
setlocal enabledelayedexpansion

:: このバッチファイルがある場所へ移動（どこから実行しても動くように）
pushd "%~dp0"

echo ========================================
echo   議事録ツール：文字起こし（Whisper）
echo ========================================
echo.

:: inputフォルダが無ければ作成
if not exist "input" mkdir "input"

:: --------------------------------------------------
:: ドラッグ＆ドロップされた音声ファイルを input にコピー
:: （ファイルをこのバッチのアイコンにドロップした場合）
:: --------------------------------------------------
if not "%~1"=="" (
    echo ドロップされたファイルを input フォルダにコピーします...
    for %%F in (%*) do (
        echo   - %%~nxF
        copy /Y "%%~F" "input\" > nul
    )
    echo.
)

:: --------------------------------------------------
:: 文字起こしの実行
:: --------------------------------------------------
echo 文字起こしを開始します。
echo （初回だけモデルのダウンロードが走るため時間がかかります）
echo.
python run_whisper.py

if %ERRORLEVEL% NEQ 0 (
    echo.
    echo [エラー] 文字起こし中に問題が発生しました。上のメッセージを確認してください。
    pause
    popd
    exit /b %ERRORLEVEL%
)

:: --------------------------------------------------
:: 完了：結果フォルダを自動で開く
:: --------------------------------------------------
echo.
echo ========================================
echo   完了しました！ output フォルダを開きます。
echo ========================================
start "" "output"

popd
pause
